{
  "baseUrl": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
  "model": "glm-5.3-flash",
  "apiKey": "REPLACE_WITH_YOUR_API_KEY",
  "apiKeyEnv": [
    "ZCODE_ADVISOR_API_KEY",
    "ZAI_API_KEY",
    "Z_AI_API_KEY",
    "ZHIPUAI_API_KEY",
    "BIGMODEL_API_KEY"
  ],
  "apiSource": "manual",
  "zcodeProvider": "",
  "zcodeModel": "",
  "systemPrompt": "",
